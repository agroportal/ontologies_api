API_URL=http://localhost:9393
ONTOLOGIES_LINKED_DATA_PATH=
GOO_PATH=
SPARQL_CLIENT_PATH=
NCBO_PATH=

## An ontology that will be imported in the starting of the API server
STARTER_ONTOLOGY=STY
## API key of a remote API used to download the starter ontology
OP_API_KEY=1de0a270-29c5-4dda-b043-7c3580628cd5
## API url of the remote API used to download the starter ontology
OP_API_URL="https://data.agroportal.eu"

## Sidekiq background jobs (submission processing + emails).
## Jobs/retries/stats live only in this Redis DB: point at a persistent Redis in production.
REDIS_SIDEKIQ_HOST=redis-ut
REDIS_SIDEKIQ_PORT=6379
REDIS_SIDEKIQ_DB=10
SIDEKIQ_CONCURRENCY=8
SIDEKIQ_PARSING_CONCURRENCY=1
## Set both to expose the Sidekiq web UI at /sidekiq (basic auth)
SIDEKIQ_WEB_USER=
SIDEKIQ_WEB_PASSWORD=
